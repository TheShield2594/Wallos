# Scheduled jobs, run by supercronic (see startup.sh). Their output goes to the
# container's stdout, so `docker logs` shows it.
# The renewal cron and the two reminder senders run every 15 minutes: renewals
# advance after each account's local midnight, and reminders go out once a day,
# at the "Send at" time in its settings.
*/15 * * * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/updatenextpayment.php
0 2 * * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/updateexchange.php
*/15 * * * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/sendcancellationnotifications.php
*/15 * * * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/sendnotifications.php
*/2 * * * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/sendverificationemails.php
*/2 * * * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/sendresetpasswordemails.php
0 */6 * * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/checkforupdates.php
30 1 * * 1 /usr/local/bin/php /var/www/html/endpoints/cronjobs/storetotalyearlycost.php
0 3 * * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/cleanupresettokens.php
30 3 * * 1 /usr/local/bin/php /var/www/html/endpoints/cronjobs/generaterecommendations.php weekly
0 4 1 * * /usr/local/bin/php /var/www/html/endpoints/cronjobs/generaterecommendations.php monthly
